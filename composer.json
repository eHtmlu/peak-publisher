{
    "name": "wppeak/peak-publisher",
    "description": "Dev tooling for the Peak Publisher WordPress plugin (the plugin itself has no build step).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Pblsh\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
